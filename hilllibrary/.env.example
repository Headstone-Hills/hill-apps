# Copy to .env and edit. Never commit .env.

# REQUIRED if the server listens on anything other than localhost.
LIBRARY_PASSWORD=change-me

PORT=3000
# 0.0.0.0 = reachable from other devices on your network. Default is 127.0.0.1
# (this machine only) when no password is set, 0.0.0.0 when one is.
# HOST=0.0.0.0

# Where the database and cover images live (back this folder up).
# DATA_DIR=./data

# Optional: Google Books works without a key but is rate limited; a free key avoids that.
# GOOGLE_BOOKS_API_KEY=

# Optional but recommended for DVDs/Blu-rays: a free TMDB API key (https://www.themoviedb.org/settings/api)
# gives accurate genres, director, runtime and posters. Without it, discs still scan (title and studio
# come from UPCitemdb) but their genre is only a keyword guess and is flagged "needs review".
# TMDB_API_KEY=

# Optional: show the movies on your Jellyfin server in the Movies tab next to the discs you own.
# Create an API key in Jellyfin: Dashboard > Advanced > API Keys. The key never leaves this server.
# JELLYFIN_API_KEY=
# JELLYFIN_URL=http://127.0.0.1:8096        # where this server can reach Jellyfin (default shown)
# JELLYFIN_PUBLIC_URL=https://jelly.example.com  # optional: adds "Open in Jellyfin" links

# Cover scanning (photograph a cover that has no barcode). Works out of the box on a Mac using Apple's
# built-in text recogniser (the first scan compiles a small helper: needs the Xcode command line tools).
# Elsewhere it falls back to Tesseract (`brew install tesseract` / `apt install tesseract-ocr`).
# Optional: also ask Claude to read covers when the local reader finds no good match. The photo is then
# sent to Anthropic (only in that case). Costs a fraction of a cent per photo.
# ANTHROPIC_API_KEY=
# COVER_VISION_MODEL=claude-haiku-5-5
# COVER_SCAN=off          # turn the feature off entirely

# Optional: serve HTTPS directly (phone cameras need HTTPS; see README).
# TLS_CERT=/path/to/fullchain.pem
# TLS_KEY=/path/to/privkey.pem

# Optional: extra browser origins allowed to make changes (comma separated), for odd proxies.
# ALLOWED_ORIGINS=https://library.example.ts.net

# Set to true ONLY when behind a proxy/tunnel (Cloudflare Tunnel, Caddy...) and bound to 127.0.0.1.
# Makes the login lockout count per real client IP instead of per proxy.
# TRUST_PROXY=true
