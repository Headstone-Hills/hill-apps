{
  "name": "hillsing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live formant-synth singing instrument: type lyrics, play them on a MIDI keyboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:dict": "node scripts/build-dict.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
