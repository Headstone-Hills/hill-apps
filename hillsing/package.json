{
  "name": "hillsing",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Live formant-synth singing instrument: type lyrics, play them on a MIDI keyboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:dict": "node scripts/build-dict.mjs",
    "app:dev": "npm run build && electron .",
    "app:build": "npm run build && electron-packager . HillSing --platform=darwin --arch=arm64 --out=release --overwrite --app-bundle-id=org.headstonehills.hillsing --app-copyright='HillSing' --ignore='^/(src|tests|e2e|scripts|release|\\.vite|HANDOFF\\.md|README\\.md|tsconfig\\.json|vite\\.config\\.ts|index\\.html)($|/)'"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.20.5",
    "electron": "^45.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  }
}
